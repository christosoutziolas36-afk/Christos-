# --- Persistenz -------------------------------------------------------------
# Ohne diese Werte laeuft Angebotsmeister im Demo-Modus (Browser-Speicher).
# Mit diesen Werten wird Supabase als Datenbank genutzt (supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Peter (Assistent) ------------------------------------------------------
# Optional. Ohne Key antwortet Peter mit der eingebauten Regel-Engine,
# ausschliesslich auf Basis der gespeicherten Betriebsdaten.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Telefonassistent -------------------------------------------------------
# Oeffentliche Adresse der App. Twilio ruft diese Webhooks auf:
#   A call comes in     -> <PUBLIC_BASE_URL>/api/voice/incoming
#   Call status changes -> <PUBLIC_BASE_URL>/api/voice/status
PUBLIC_BASE_URL=

# Auth Token aus der Twilio-Konsole. Ohne diesen Wert werden eingehende
# Webhooks NICHT geprueft - vor dem Livegang zwingend setzen.
TWILIO_AUTH_TOKEN=

# Stimme der Ansage (Amazon Polly, deutsche Stimmen: Vicki, Daniel, Hans).
VOICE_TTS_VOICE=Polly.Vicki

# Fallback fuer die Ansage, solange keine Betriebsdaten in Supabase liegen.
VOICE_COMPANY_NAME=
VOICE_COMPANY_OWNER=

# Schreibt der Telefon-Webhook nach Supabase, wird dieser Key benoetigt
# (Service Role, nur serverseitig - niemals im Browser verwenden).
SUPABASE_SERVICE_ROLE_KEY=
