# --- Persistenz -------------------------------------------------------------
# Ohne diese Werte laeuft Angebotsmeister im Demo-Modus (Browser-Speicher).
# Mit diesen Werten wird Supabase als Datenbank genutzt (supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

